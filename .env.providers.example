# ============================================================
# نموذج ربط المزوّد الأول (Provider #1) — املأه ثم انسخ القيم
# إلى ملف .env الخاص بك (لا تضع الأسرار في أي ملف تلتزمه في Git)
# ------------------------------------------------------------
# بعد تعبئة هذا الملف، انسخ سطور PROVIDERS_COUNT و PROVIDER_1_*
# إلى ملف .env ثم أعد تشغيل السيرفر واذهب إلى:
#   لوحة الأدمن ← المزوّدون والمزامنة ← "مزامنة الآن"
# ------------------------------------------------------------
# 🏆 أفضل سعر عبر المزودين (تلقائي):
# عندما يُقدّم مزودان أو أكثر نفس السلعة (الفئة + المنطقة + الاسم
# الموحّد متطابقة)، يعتمد المتجر الأرخص تلقائياً ويعرضه فقط،
# ويُخفى الأغلى. وعند تعذّر الشراء من الأرخص يُنتقل تلقائياً
# للمزوّد التالي حتى التسليم للزبون.
# ============================================================

# --- الرقم الإجمالي للمزوّدين (1 = مزوّد واحد فقط) ---
PROVIDERS_COUNT=1

# ===== هوية المزوّد =====
# اسم المزوّد (يظهر في اللوحة وسجلات المزامنة) — مثال: FZR
PROVIDER_1_NAME=FZR

# تشغيل/إيقاف المزوّد (true/false)
PROVIDER_1_ENABLED=true

# مفتاح API الذي يمنحك إياه المزوّد (سري — لا تشاركه)
# FazerCards: يبدأ بـ fc_ ويُنشأ من لوحة الريسلر
PROVIDER_1_API_KEY=your-api-key-here

# نوع المحول (محوّل التعامل مع المزوّد):
#   generic    → الإعداد الافتراضي: كتالوج مسطح عبر رابط واحد (أغلب المزوّدين)
#   fazercards → محوّل خاص بـ FazerCards: كتالوج هرمي + شراء غير متزامن
PROVIDER_1_ADAPTER_TYPE=fazercards

# الرابط الأساسي لواجهة المزوّد (بدون شرطة نهائية)
# FazerCards: https://api.fzr.cards/api/v2
PROVIDER_1_BASE_URL=https://api.fzr.cards/api/v2

# ===== المصادقة =====
# FazerCards: يُرسل المفتاح في رأس X-API-Key — استخدم apikey-header
PROVIDER_1_AUTH_TYPE=apikey-header

# اسم رأس المفتاح عند النوع apikey-header (FazerCards: X-API-Key)
PROVIDER_1_API_KEY_HEADER=X-API-Key

# ===== الروابط (اختياري: تُشتق من BASE_URL إن تُركت فارغة) =====
# جلب قائمة المنتجات  → افتراضي: <BASE>/items
PROVIDER_1_ITEMS_URL=
# جلب الرصيد          → افتراضي: <BASE>/balance
PROVIDER_1_BALANCE_URL=
# شراء منتج           → افتراضي: <BASE>/buy
PROVIDER_1_PURCHASE_URL=

# ===== العملة والهامش =====
# عملة أسعار المزوّد (USD / TRY / EUR ...) — ستُحوَّل تلقائياً لعملة متجرك
PROVIDER_1_CURRENCY=USD

# هامش الربح الافتراضي لهذا المزوّد (1.15 = إضافة 15%)
PROVIDER_1_MARGIN=1.15

# ===== مسار عناصر القائمة في الاستجابة =====
# إذا كانت استجابة GET items على الشكل: { "success":true, "data":{ "items":[...] } }
# ضع: PROVIDER_1_ITEMS_PATH=data.items
# وإذا كانت مصفوفة مباشرة اتركها فارغة
PROVIDER_1_ITEMS_PATH=data.items

# ===== تسمية الحقول في كائن المنتج الواحد =====
# اكتب اسم الحقل داخل كائن المزوّد، حسب ما يرسله فعلياً:
# مثال: { "id": "123", "price": 5.5, "currency": "USD", "name_ar": "...", "name_en": "..." }
PROVIDER_1_ID_FIELD=id
PROVIDER_1_PRICE_FIELD=price
PROVIDER_1_PRICE_CURRENCY_FIELD=currency
PROVIDER_1_NAME_AR_FIELD=name_ar
PROVIDER_1_NAME_EN_FIELD=name_en
PROVIDER_1_IMAGE_FIELD=image
PROVIDER_1_STOCK_FIELD=stock
PROVIDER_1_CATEGORY_FIELD=category
PROVIDER_1_REGION_FIELD=region
PROVIDER_1_DESCRIPTION_FIELD=description

# ===== خرائط تحويل (اختياري): من قيم المزوّد إلى قيم المتجر =====
# قيم المتجر المسموحة للأقسام:
# gaming_general, pubg, fortnite, playstation, xbox, microsoft_windows,
# adobe, antivirus, vpn, google, itunes, razer_gold, amazon, steam
PROVIDER_1_CATEGORY_MAPPING=steam:steam,psn:playstation

# قيم المتجر المسموحة للمناطق:
# global, us, tr, eu, sa
PROVIDER_1_REGION_MAPPING=global:global,tr:tr

# القيم الافتراضية عند عدم تطابق أي خريطة
PROVIDER_1_DEFAULT_CATEGORY=gaming_general
PROVIDER_1_DEFAULT_REGION=global

# ============================================================
# ✔️ كيف يتحقق الكود أن ربط المزوّد صحيح؟ (اختبار سريع قبل الشراء)
# ------------------------------------------------------------
# 1) قائمة المنتجات:  GET  PROVIDER_1_ITEMS_URL
#      -> يجب أن تُرجع مصفوفة (أو مسار PROVIDER_1_ITEMS_PATH منها)
#      -> كل عنصر يجب أن يحتوي منطقة price رقمية صالحة
# 2) الرصيد:          GET  PROVIDER_1_BALANCE_URL
#      -> يُقرأ من: data.balance | data.wallet.balance | balance | amount
# 3) الشراء:          POST PROVIDER_1_PURCHASE_URL
#      الجسم المُرسل: { "api_key": KEY, "product_id": externalId, "amount": quantity }
#      الرد يجب أن يحتوي مصفوفة الأكواد من إحدى الصيغ:
#         { "codes": [...] }  أو  { "items": [{code|pin}...] }  أو  { "code": "..." }
#      وسعر التكلفة يُقرأ من: costPrice | cost | price
# ------------------------------------------------------------
# إذا حصلت على "تحويل عملة فشل" (فشل تحويل العملة) أضف تجاوزاً يدوياً:
# FX_USD_ILS=3.75
# أو ضع سعر صرف حقيقي لكل زوج تحتاجه في .env
# ============================================================