# Application
PORT=5850
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/joker-store

# Security
JWT_SECRET=replace-with-strong-secret
ADMIN_PASSWORD_HASH=$2b$10$replaceWithBcryptHash

# Optional integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STRIPE_SECRET_KEY=

# Optional email notifications
RESEND_API_KEY=
EMAIL_USER=

# Storefront settings (payment numbers, social links, stats)
# ضع القيم الحقيقية هنا لتظهر للمشتري في صفحة الدفع
JAWWAL_PAY_NUMBER=059XXXXXXX
PALPAY_NUMBER=9XXXXX
WHATSAPP_NUMBER=
TELEGRAM_LINK=
INSTAGRAM_LINK=
TIKTOK_LINK=
STAT_CUSTOMERS=2500
STAT_ORDERS=8500
STAT_DELIVERY_MIN=10
STAT_SUPPORT_HOURS=24
