# Application
PORT=5850
NODE_ENV=development
# فرض HTTPS/إعادة التوجيه: تُركت للافتراضي (فعل في الإنتاج، 0 للتجربة المحلية)
# FORCE_HTTPS=0

# Rate limiting — الحد الأقصى لطلبات /api/ لكل IP خلال 15 دقيقة (افتراضي 300)
API_RATE_LIMIT_MAX=300

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/joker-store

# Security
# مفتاح توقيع جلسات الأدمن (مطلوب — استخدم قيمة عشوائية طويلة)
JWT_SECRET=replace-with-strong-secret
# مفتاح توقيع جلسات المستخدمين (اختياري؛ إن لم يُضبط يُستخدم JWT_SECRET)
JWT_USER_SECRET=replace-with-strong-secret-for-users
# Bcrypt hash لكلمة مرور الأدمن — أنشئه بأداة مثل htpasswd/bcrypt عبر الإنترنت
ADMIN_PASSWORD_HASH=$2b$10$replaceWithBcryptHash
# رمز تحقق ثنائي اختياري (6 أرقام) — إن ضُبط يُطلب مع كلمة المرور
ADMIN_2FA_CODE=

# External providers (B2B) — يُفعَّل الربط عند ضبط PROVIDERS_COUNT ومفاتيح API
# عملة المتجر الأساسية (تُحوَّل إليها جميع أسعار المزودين تلقائياً)
# الافتراضي: ILS (شيكل) — الأسعار تُعرض في المتجر بهذه العملة
STORE_CURRENCY=ILS
# رمز العملة المعروض في الواجهة أمام الأسعار
STORE_CURRENCY_SYMBOL=₪

# عدد المزودين المسجلين
PROVIDERS_COUNT=0

# لكل مزود (استبدل 1 برقم المزود):
# PROVIDER_1_NAME=SteamKeys
# PROVIDER_1_ENABLED=true
# PROVIDER_1_API_KEY=your-api-key
# PROVIDER_1_BASE_URL=https://api.provider.example
# PROVIDER_1_ADAPTER_TYPE=generic          # generic | fazercards (محوّل خاص بـ FazerCards: كتالوج هرمي وشراء غير متزامن)
# PROVIDER_1_ITEMS_URL=                # اختياري: الافتراضي BASE_URL/items (يُتجاهل مع adapterType=fazercards)
# PROVIDER_1_BALANCE_URL=              # اختياري: الافتراضي BASE_URL/balance
# PROVIDER_1_PURCHASE_URL=             # اختياري: الافتراضي BASE_URL/buy
# PROVIDER_1_AUTH_TYPE=bearer          # bearer | apikey-header | apikey-query | none
# PROVIDER_1_API_KEY_HEADER=Authorization
# PROVIDER_1_CURRENCY=USD              # عملة أسعار المزود (USD/TRY/EUR...)
# PROVIDER_1_MARGIN=1.15               # هامش الربح الافتراضي لهذا المزود
# PROVIDER_1_ITEMS_PATH=data.items     # مسار مصفوفة المنتجات في الاستجابة
# PROVIDER_1_ID_FIELD=id
# PROVIDER_1_PRICE_FIELD=price
# PROVIDER_1_PRICE_CURRENCY_FIELD=currency
# PROVIDER_1_NAME_AR_FIELD=name_ar
# PROVIDER_1_NAME_EN_FIELD=name_en
# PROVIDER_1_IMAGE_FIELD=image
# PROVIDER_1_STOCK_FIELD=stock
# PROVIDER_1_CATEGORY_FIELD=category
# PROVIDER_1_REGION_FIELD=region
# PROVIDER_1_DESCRIPTION_FIELD=description
# PROVIDER_1_CATEGORY_MAPPING=steam:steam,psn:playstation
# PROVIDER_1_REGION_MAPPING=global:global,tr:tr
# PROVIDER_1_DEFAULT_CATEGORY=gaming_general
# PROVIDER_1_DEFAULT_REGION=global

# هامش الربح العام (يُستخدم عندما لا يوجد هامش للمنتج/الفئة/المزود)
DEFAULT_PROFIT_MARGIN=1.10
# هوامش افتراضية للفئات (اختياري) — مثال:
# CATEGORY_MARGIN_STEAM=1.15
# CATEGORY_MARGIN_PUBG=1.25

# ربح ثابت حسب طبقة سعر الشراء (نظام التسعير الافتراضي — يُفعَّل عندما لا يوجد هامش محدد)
# سعر شراء أقل من 50 → +5، و50+ → +10، و100+ → +15، و200+ → +20
# PROFIT_TIER_UNDER_50=5
# PROFIT_TIER_UNDER_100=10
# PROFIT_TIER_UNDER_200=15
# PROFIT_TIER_200_PLUS=20

# حماية الأسعار من أخطاء المزودين
# أعلى نسبة تغيّر مقبولة لسعر الأساس قبل تجميده (حماية من أخطاء المزود)
PRICE_MAX_CHANGE_RATIO=4
# نسبة الارتفاع التي تُطلق تنبيهاً في تيليجرام (1.20 = ارتفاع 20%)
PRICE_ALERT_RATIO=1.20

# أسعار الصرف (اختياري)
# تجاوز يدوي: FX_USD_ILS=3.75  (قيمة سعر التحويل المباشر من عملة لأخرى — إن وُضعت تعطّل التحديث التلقائي لهذا الزوج)
# مفتاح خدمة أسعار الصرف (اختياري — إن تُرك فارغاً تُستخدم open.er-api.com المجانية)
FX_API_KEY=
FX_API_URL=
# مدة حفظ أسعار الصرف بالدقائق (يُجلب السعر تلقائياً كلما انتهت المدة — تحديث يومي/أقصر)
FX_CACHE_TTL_MIN=60

# جدولة المزامنة (بالساعات) — تبقي الأسعار محدثة تلقائياً
SYNC_INTERVAL_HOURS=6
# تأخير المزامنة الأولى بعد إقلاع السيرفر (بالثواني)
INITIAL_SYNC_DELAY_SEC=30

# مراقبة أرصدة المزودين (اختياري)
# تنبيه تيليجرام عندما يهبط رصيد أي مزود دون هذه العتبة (بوحدة عملة المزود)
LOW_BALANCE_THRESHOLD=10
# لا يُكرَّر تنبيه نفس المزود قبل مرور هذا العدد من الساعات
BALANCE_REALERT_HOURS=24
# فترة الفحص الدوري للأرصدة (بالساعات)
BALANCE_CHECK_INTERVAL_HOURS=6

# حماية هامش الربح عند التنفيذ
# أدنى نسبة (سعر البيع / التكلفة) مسموحة؛ الافتراضي 1.0 يمنع البيع بخسارة
MIN_PROFIT_RATIO=1.00
# هامش آمن ديناميكي ضد تقلّب أسعار المزودين وسعر الصرف (يُضاف تلقائياً)
# SAFE_FX_BUFFER=0.02              # 2% إضافية إذا عملة المزود ≠ ILS
# SAFE_VOLATILITY_BUFFER=0.05      # 5% إضافية إذا تغيّر basePrice >10% فجأة
# SAFE_VOLATILITY_THRESHOLD=0.10   # عتبة التقلّب (10%)
# SAFE_MIN_ABSOLUTE_PROFIT=5       # حد أدنى ربح مطلق 5₪ (يحمي المنتجات الرخيصة)

# Stripe (اختياري) — الدفع بالبطاقة عبر صفحات Checkout المستضافة
STRIPE_SECRET_KEY=
# أمان: يجب ضبط سر الـ Webhook من لوحة Stripe حتى تُقبل إشعارات الدفع
STRIPE_WEBHOOK_SECRET=

# شبكة المزودين (اختياري)
PROVIDER_TIMEOUT_MS=15000
PROVIDER_RETRY_COUNT=1

# Telegram alerts (اختياري)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications (اختياري) — يُرسل للزبون أكواد الطلب عند التأكيد، وإشعار الرفض
# إن تُرك SMTP_HOST فارغاً تُعطّل إشعارات البريد تلقائياً.
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Joker Store <noreply@your-real-domain.com>

# Storefront settings (payment numbers, social links)
# القيم الحقيقية فقط — اتركها فارغة إن لم تكن مضبوطة وسيُخفى العنصر في الواجهة
JAWWAL_PAY_NUMBER=
PALPAY_NUMBER=
REFAKT_NUMBER=
WHATSAPP_NUMBER=
TELEGRAM_LINK=
INSTAGRAM_LINK=
TIKTOK_LINK=
# ملاحظة: إحصائيات الواجهة (العملاء، الطلبات) تُحسب الآن تلقائياً من قاعدة البيانات،
# ولا تُضبط يدوياً هنا — لضمان عدم عرض أرقام غير حقيقية.

# كاش واجهة المتجر (بالثواني، 0 = تعطيل)
# يخفف ضغط قاعدة البيانات عند تكرار الزيارات؛ يُمسح تلقائياً بعد كل مزامنة أسعار
STOREFRONT_CACHE_TTL=60

# تحليلات (اختياري — تُفعّل فقط إن ضُبطت، لا تُرسل بيانات وهمية)
GA_MEASUREMENT_ID=
META_PIXEL_ID=
