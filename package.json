{
  "name": "website-joker-store",
  "version": "1.0.0",
  "description": "متجر الجوكر للبطاقات الرقمية والألعاب",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env FORCE_HTTPS=0 NODE_ENV=development nodemon server.js",
    "lint": "eslint \"**/*.js\"",
    "test": "jest --detectOpenHandles --forceExit",
    "test:e2e": "playwright test",
    "build:assets": "node scripts/build-assets.js",
    "optimize:images": "node scripts/optimize-images.js",
    "verify": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "overrides": {
    "rimraf": {
      "glob": "^14.0.4"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@sentry/node": "^11.11.0",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/preset-env": "^7.29.7",
    "@playwright/test": "^1.65.0",
    "clean-css": "^5.3.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^50.8.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sharp": "^0.35.5",
    "supertest": "^6.3.3",
    "terser": "^5.51.2"
